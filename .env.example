APP_NAME=Alumnx AI Sales inbox task router
APP_ENV=development
LOG_LEVEL=INFO

CANDIDATE_ID=mahendrushivam123@gmail.com
FRONTEND_ORIGINS=http://localhost:5173

SUPABASE_DB_URL=
# Optional: leave empty to use SUPABASE_DB_URL for Alembic migrations.
SUPABASE_MIGRATION_DB_URL=
PRODUCTION_SUPABASE_HOST=
PRODUCTION_SUPABASE_PROJECT_REF=
ALLOW_PRODUCTION_TEST_DATABASE=false
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_RECYCLE_SECONDS=300

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.1
GEMINI_BATCH_SIZE=5
GEMINI_REQUESTS_PER_MINUTE=5
GEMINI_MAX_CONCURRENCY=1
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=5
GEMINI_MAX_OUTPUT_TOKENS=8192

INGEST_MAX_EMAILS=100
INGEST_MAX_REQUEST_BYTES=26214400
EMAIL_BODY_MAX_CHARS=250000
NORMALIZED_PROMPT_MAX_CHARS=30000

ROUTING_PROMPT_VERSION=routing-v1
CHAT_PROMPT_VERSION=chat-v1
